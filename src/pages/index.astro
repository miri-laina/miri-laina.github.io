---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/news/Header.astro';
import NewsHeader from '../components/news/Header.astro';
import NewsButton from '../components/news/Button.astro';
import DataItem from '../components/news/DataItem.astro';
import Footer from '../components/news/Footer.astro';
import ProjectLarge from '../components/news/ProjectLarge.astro';
import SideProjectItem from '../components/news/SideProjectItem.astro';
import Chips from '../components/news/Chips.astro';
import BentoGrid from '../components/news/BentoGrid.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import CustomCursor from '../components/CustomCursor.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../data/projects';

const mainProjects = projects.filter(p => !p.isSideProject);
const sideProjects = projects.filter(p => p.isSideProject);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-primary min-h-screen flex flex-col">
		<!-- Mobile Design (visible solo en mobile) -->
		<div class="md:hidden bg-white w-full min-h-screen flex flex-col">
				<!-- Header Mobile -->
				<nav class="bg-white flex h-12 items-center justify-between px-4 py-2 sticky top-0 w-full z-50">
					<div class="h-6 w-9 relative">
						<img src="/favicon.svg" alt="Miriam Laina" class="h-full w-auto" loading="eager" fetchpriority="high" />
					</div>
				</nav>
				
				<!-- Hero Mobile -->
				<header class="flex flex-col items-start px-4 py-12 w-full">
					<div class="flex flex-col gap-10 items-end justify-end w-full">
						<div class="flex flex-col items-start w-full">
							<div class="flex flex-col gap-10 items-start w-full">
								<p class="font-heading font-bold text-[40px] leading-[100%] text-secondary w-full">
									Cases are optimised for desktop experience
								</p>
								<p class="font-body font-semibold text-[24px] leading-[100%] text-secondary-400 w-full">
									Leave the FOMO behind and view it on desktop.
								</p>
							</div>
						</div>
						<div class="relative w-[172px] h-[172px] shrink-0">
							<svg width="172" height="172" viewBox="0 0 418 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
								<path d="M210 0C323.325 0 415.684 89.7654 419.853 202.071H208V209H420V420H211V419.997C210.667 419.999 210.334 420 210 420C94.0202 420 0 325.98 0 210C0 94.0202 94.0202 0 210 0Z" fill="#0A0908"/>
							</svg>
						</div>
					</div>
				</header>
				
				<!-- Footer Mobile -->
				<footer class="bg-secondary flex flex-col gap-8 items-center justify-center pb-6 pt-10 px-4 w-full">
					<div class="flex flex-col gap-8 items-start w-full">
						<div class="flex flex-col gap-4 items-start px-4 w-full">
							<div class="flex flex-col gap-4 items-start w-full">
								<p class="font-body font-semibold text-[24px] leading-[100%] text-white w-full">
									Designing digital things, enjoying analog life.
								</p>
								<p class="font-body font-bold text-[16px] leading-[100%] text-secondary-200">
									Product Designer
								</p>
								<a 
									href="https://www.linkedin.com/in/miriam-laina-p%C3%A9rez-622956168/" 
									target="_blank" 
									class="w-6 h-6 hover:opacity-70 transition-opacity"
									aria-label="LinkedIn"
								>
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="#ffffff"/>
									</svg>
								</a>
							</div>
							<div class="flex flex-col gap-8 items-start">
								<div class="h-[52px] w-[203px]">
									<img src="/logo.svg" alt="Miriam Laina" class="h-full w-auto brightness-0 invert" loading="eager" />
								</div>
								<p class="font-body text-[14px] leading-[100%] text-secondary-100">
									Miriam Laina © {new Date().getFullYear()}
								</p>
							</div>
						</div>
						<div class="w-full h-[2px] bg-white"></div>
						<div class="w-full h-[2px] bg-white"></div>
					</div>
				</footer>
			</div>
		
		<!-- Desktop Design (visible solo en desktop) -->
		<div class="hidden md:block w-full">
			<!-- Noise overlay que está por encima de todo -->
			<!-- <div class="noise-overlay"></div> -->
			<Header theme="light" />
			
			<main class="w-full flex flex-col">
		<!-- Hero Section -->
		<section class="w-full px-4 md:px-16 py-8 md:py-20 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-12 min-h-[400px] md:min-h-[758px]">
			<div class="flex flex-col gap-4 md:gap-6 max-w-[764px] w-full">
				<div class="flex flex-col gap-4 md:gap-6">
					<div class="w-full md:w-[200px]">
						<Chips variant="outline" text="Product Designer" />
					</div>
					<h2 id="hero-title" class="text-2xl md:text-h2 font-heading font-bold leading-tight md:leading-[1.2] text-secondary">Merging design, strategy and technology to craft products.</h2>
				</div>
				<div class="flex flex-col font-bold text-base md:text-sb1 font-sb text-secondary-300">
					<p id="hero-subtitle">Harnessing technology to make life better.</p>
				</div>
			</div>
			<div id="hero-image" class="w-full md:w-[420px] h-[300px] md:h-[420px] flex-shrink-0">
				<svg id="hero-svg" width="418" height="420" viewBox="0 0 418 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
					<path id="hero-path" d="M210 0C323.325 0 415.684 89.7654 419.853 202.071H208V209H420V420H211V419.997C210.667 419.999 210.334 420 210 420C94.0202 420 0 325.98 0 210C0 94.0202 94.0202 0 210 0Z" fill="#0A0908"/>
				</svg>
			</div>
		</section>

		<!-- Bento Grid Section -->
		<BentoGrid />

			<!-- Philosophy Section -->
			<section class="w-full px-4 md:px-16 py-12 md:py-[120px] flex flex-col items-start gap-8 md:gap-14">
				<h2 class="text-2xl md:text-h2 font-heading font-bold text-secondary text-start">Create design from human for humans</h2>
				<div class="flex flex-col gap-4 max-w-[1152px] text-sm md:text-body-md font-body text-secondary-300 text-start">
					<p>
						<strong>Behind the pixels:</strong> I always begin with the real problem before falling in love with the visual solution, because design isn't just about aesthetics. It's about solving challenges grounded in data so others don't have to face the complexity. It's about distilling the difficult into a clear guiding principle. 
						<br/> 
					</p>
					<p class="font-bold font-body">It's about creating memorable, distinctive experiences so seamless they're simply enjoyable to use.</p>
				</div>
				<NewsButton href="/about" text="Read about me" />
			</section>

			<!-- Projects Section -->
			<section class="w-full px-4 md:pl-16 py-12 md:py-[120px] flex flex-col gap-8 md:gap-12">
				<h2 class="text-2xl md:text-h3 font-heading font-bold text-secondary">Projects</h2>
				
				<div class="flex flex-col w-full">
					{mainProjects.map((project, index) => (
						<div class="border-t-2 border-secondary-200">
							<ProjectLarge 
								imageSrc={project.coverImage || '/placeholder-hero.jpg'}
								category={project.industry || ''}
								title={project.title}
								description={project.intro?.split('\n')[0] || project.description.split('\n')[0]}
								tags={project.tags || []}
								slug={project.slug}
							/>
						</div>
					))}
				</div>
			</section>

			<!-- Industries Section -->
			<section class="w-full bg-secondary px-4 md:px-14 py-12 md:py-[120px] flex flex-col items-center gap-8 md:gap-16">
				<h2 class="text-xl md:text-h2 font-heading font-bold text-primary text-center">INDUSTRIES OF EXPERTISE</h2>
				<div class="flex gap-4 md:gap-6 flex-wrap justify-center">
					<DataItem variant="icon" cardStyle="filled" title="Security" />
					<DataItem variant="icon" cardStyle="filled" title="Energy" />
					<DataItem variant="icon" cardStyle="filled" title="Telco" />
					<DataItem variant="icon" cardStyle="filled" title="Automotive" />
					<DataItem variant="icon" cardStyle="filled" title="AI" />
				</div>
			</section>

			<!-- Side Projects Section -->
			<section class="w-full bg-secondary px-4 md:px-16 py-12 md:py-[120px] flex flex-col md:flex-row gap-8 md:gap-14 items-start md:items-end">
				<div class="flex flex-col gap-4 md:gap-6 max-w-[750px] w-full">
					<h2 class="text-2xl md:text-h2 font-heading font-bold leading-tight md:leading-[1.2] text-primary">
						Side projects
					</h2>
					<p class="text-sm md:text-body-md font-body text-primary pb-4">Personal projects where I explore ideas, technologies, and narratives that inspire me. Spaces for experimentation — to learn, fail, and create without limits.</p>
				</div>
				<div class="flex-1 flex flex-col gap-0 w-full md:w-[530px] lg:w-[730px] xl:w-[830px]">
					{sideProjects.map((project, index) => (
						<SideProjectItem 
							iconImage={project.iconImage || ''}
							title={project.title}
							description={project.intro?.split('\n')[0] || project.description.split('\n')[0]}
							slug={project.slug}
							isLast={index === sideProjects.length - 1}
						/>
					))}
				</div>
			</section>
			</main>

			<Footer />

			<HeroAnimation />
			<CustomCursor />
		</div>
		
		<!-- Script para redirigir desde otras rutas en mobile -->
		<script>
			// Detectar si es mobile basado en el ancho de pantalla
			function isMobileWidth() {
				return window.innerWidth < 768; // md breakpoint de Tailwind
			}
			
			// Si estamos en mobile y no estamos en la página principal, redirigir
			if (isMobileWidth() && window.location.pathname !== '/') {
				// Solo redirigir si no es un asset estático
				const pathname = window.location.pathname;
				const isStaticAsset = pathname.startsWith('/_astro') || 
					pathname.startsWith('/favicon') || 
					pathname.startsWith('/logo') || 
					pathname.startsWith('/fonts') || 
					pathname.startsWith('/images') || 
					pathname.startsWith('/projects') || 
					pathname.startsWith('/icons') || 
					pathname.startsWith('/cv-') || 
					pathname.startsWith('/blog') || 
					pathname.startsWith('/rss.xml');
				
				if (!isStaticAsset) {
					window.location.href = '/';
				}
			}
		</script>
	</body>
</html>
